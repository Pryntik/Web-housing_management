<html>
    <head>
        <link href="../styles/master.scss" rel="stylesheet" type="text/css">
    </head>
    <body>
        <div class="app">
            <nav class="navBar">
                <div class="nav-page">
                    <button class="<%=pageName == 'Home' ? 'page-active' : ''%> nav-button" onclick="window.location='/';">Home</button>
                    <button class="<%=pageName == 'Addnews' ? 'page-active' : ''%> nav-button" onclick="window.location='/addnews';">Nouvelle annonce</button>
                    <button class="<%=pageName == 'About' ? 'page-active' : ''%> nav-button" onclick="window.location='/about';">About</button>
                </div>
                <div class="nav-log">
                    <button class="<%=pageName == 'Signup' ? 'page-active' : ''%> nav-button" onclick="window.location='/signup';">Sign up</button>
                    <button class="<%=pageName == 'Login' ? 'page-active' : ''%> nav-button" onclick="window.location='/login';">Log in</button>
                </div>
            </nav>
            <div class="logBar">
                <div class="logStatus">
                    <span class="log-text"><%=logStatus == true ? 'Connected' : 'Disconnected'%></span>
                    <img class="log-icon" src="<%=logStatus == true ? '/images/logo-connected.png' : '/images/logo-disconnected.png'%>" alt="log-icon">
                </div>
            </div>
            <div class="center-gray-block w60 h60">
                <h1 class="app-title"><%=pageName%> page</h1>
                <div class="news-list">
                    <% if (news && news.length > 0) { %>
                        <h2>Mes Annonces :</h2>
                        <ul>
                            <% news.forEach(function(annonce) { %>
                                <li>
                                    <h3><%= annonce.titre %></h3>
                                    <p>Type: <%= annonce.typeBien %></p>
                                    <p>Description: <%= annonce.description %></p>
                                    <p>Prix: <%= annonce.prix %> €</p>
                                    <p>Statut: <%= annonce.statutPublication %></p>
                                    <% if (annonce.photos.length > 0) { %>
                                        <img src="data:<%= annonce.photos[0].contentType %>;base64,<%= annonce.photos[0].data.toString('base64') %>" alt="<%= annonce.titre %>" />
                                    <% } %>
                                    <button onclick="window.location.href='/annonces/<%= annonce._id %>'">Posez une question</button>
                                    <% if (annonce.questions.length > 0) { %>
                                        <h2>Questions posées :</h2>
                                            <% annonce.questions.forEach(question => { %>
                                                <p><strong><%= question.user.login %></strong>  le : <strong><%= question.date.toLocaleDateString()%> </strong>a demandé :</p>
                                                <p><%= question.contenu %></p>
                                                <h4>Réponses :</h4>
                                                <ul>
                                                    <% question.reponses.forEach(reponse => { %>
                                                        <li><%= reponse.contenu %> - par <strong><%= reponse.user.login %></strong> le : <strong><%= reponse.date.toLocaleDateString()%></strong> </li>
                                                    <% }) %>
                                                </ul>
                                                <button onclick="window.location.href='/annonces/<%= annonce._id %>/questions/<%= question._id %>'">Répondre à la question</button>
                                            <% }) %>
                                    <% } else { %>
                                        <p>Aucune question publiée</p>
                                    <% } %>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <p>Aucune annonce publiée.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </body>
</html>
