<html>
    <head>
        <link href="../styles/master.css" rel="stylesheet" type="text/css">
    </head>
    <body>
        <div class="app">
            <nav class="navBar">
                <div class="nav-page">
                    <button class="<%=pageName == 'Home' ? 'page-active' : ''%> nav-button" onclick="window.location='/';">Home</button>
                    <button class="<%=pageName == 'News' ? 'page-active' : ''%> nav-button" onclick="window.location='/addnews';">Nouvelle annonce</button>
                    <button class="<%=pageName == 'About' ? 'page-active' : ''%> nav-button" onclick="window.location='/about';">About</button>
                </div>
                <div class="nav-log">
                    <button class="<%=pageName == 'Signup' ? 'page-active' : ''%> nav-button" onclick="window.location='/signup';">Sign up</button>
                    <button class="<%=pageName == 'Login' ? 'page-active' : ''%> nav-button" onclick="window.location='/login';">Log in</button>
                </div>
            </nav>
            <div class="logBar">
                <div class="logStatus">
                    <span class="log-text"><%=logStatus == true ? 'Connected' : 'Disconnected'%></span>
                    <img class="log-icon" src="<%=logStatus == true ? '/images/logo-connected.png' : '/images/logo-disconnected.png'%>" alt="log-icon" onclick="window.location='/logout';">
                </div>
            </div>
            <div class="center-gray-block w60 h60">
                <h1 class="app-title"><%=pageName%> page</h1>
                <div class="news-list">
                    <% if (logStatus && news && news.length > 0) { %>
                        <div class="card-head-news">
                            <h2>Mes Annonces :</h2>
                            <button class="<%= pageName === 'Home' ? 'button-public' : 'button-private' %> button-status-news"
                                onclick="<%=pageName === 'Home' ? 'window.location=\'/newsPrivees\';': 'window.location=\'/\';'%>">
                                Publique
                            </button>
                        </div>
                            <% news.forEach(function(news) { %>
                                <% if (news.statutPublication === 'publique') { %>
                                    <div class="news-card">
                                        <% news.photos.forEach(function(photo) { %>
                                            <img src="data:<%= photo.contentType %>;base64,<%= photo.data.toString('base64') %>" alt="<%= news.titre %>" class="news-logo"/>
                                        <% }) %>
                                        <h3 class="news-title"><%=news.titre%></h3>
                                        <span class="news-type"><%=news.typeBien%></span>
                                        <span class="news-price"><%=news.prix%> €</span>
                                        <span class="news-status"><%=news.statutPublication%></span>
                                        <p class="news-description"><%=news.description%></p>
                                        <div class="news-card-button">
                                            <button class="news-button news-button-question" onclick="window.location.href='/news/<%= news._id %>'">Questions (<%=news.questions.length%>)</button>
                                            <button class="news-button news-button-edit" onclick="window.location.href='/news/<%= news._id %>/editNews'">Modifier</button>
                                            <button class="news-button news-button-delete" onclick="window.location.href='/news/<%= news._id %>/deleteNews'">Supprimer</button>
                                        </div>
                                    </div>
                                <% } %>
                            <% }); %>
                    <% } else if (logStatus === false && news && news.length > 0) { %>
                        <p>Connectez-vous pour voir vos annonces</p>
                    <% } else { %>
                        <p>Aucune news publiée</p>
                    <% } %>
                </div>
            </div>
        </div>
    </body>
</html>
