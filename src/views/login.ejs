<html>
    <head>
        <link href="../styles/index.scss" rel="stylesheet" type="text/css">
        <link href="../styles/navbar.scss" rel="stylesheet" type="text/css">
        <link href="../styles/login.scss" rel="stylesheet" type="text/css">
    </head>
    <body>
        <nav class="home-nav">
            <div class="nav-page">
                <button class="<%=pageName == 'Home' ? 'page-active' : ''%> nav-button" onclick="window.location='/';">Home</button>
                <button class="<%=pageName == 'About' ? 'page-active' : ''%> nav-button" onclick="window.location='/about';">About</button>
            </div>
            <div class="nav-log">
                <button class="<%=pageName == 'Login' ? 'page-active' : ''%> nav-button" onclick="window.location='/login';">Log in</button>
                <button class="nav-button" onclick="window.location='/';">Log out</button>
            </div>
        </nav>
        <div class="center-block">
            <h1 class="login-title"><%=pageName%> page</h1>
            <div class="login-form">
                <form action="/login/check" method="post"></form>
                    <input id="login" name="login" type="text" autocomplete="login" placeholder="Username" required autofocus>
                    <input id="current-password" name="password" type="password" autocomplete="current-password" placeholder="Password" required>
                    <button type="submit">Sign in</button>
                </form>
            </div>
        </div>
    </body>
</html>