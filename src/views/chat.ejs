<html>
    <head>
        <link href="/styles/master.css" rel="stylesheet" type="text/css">
    </head>
    <body>
        <div class="app">
            <nav class="navBar">
                <div class="nav-page">
                    <button class="<%=pageName == 'Home' ? 'page-active' : ''%> nav-button" onclick="window.location='/';">Home</button>
                    <button class="<%=pageName == 'News' ? 'page-active' : ''%> nav-button" onclick="window.location='/addnews';">Nouvelle annonce</button>
                    <button class="<%=pageName == 'About' ? 'page-active' : ''%> nav-button" onclick="window.location='/about';">About</button>
                </div>
                <div class="nav-log">
                    <button class="<%=pageName == 'Signup' ? 'page-active' : ''%> nav-button" onclick="window.location='/signup';">Sign up</button>
                    <button class="<%=pageName == 'Login' ? 'page-active' : ''%> nav-button" onclick="window.location='/login';">Log in</button>
                </div>
            </nav>
            <div class="logBar">
                <div class="logStatus">
                    <span class="log-text"><%=logStatus == true ? 'Connected' : 'Disconnected'%></span>
                    <img class="log-icon" src="<%=logStatus == true ? '/images/logo-connected.png' : '/images/logo-disconnected.png'%>" alt="log-icon" onclick="window.location='/logout';">
                </div>
            </div>
            <div class="center-gray-block w60 h60">
                <h1 class="login-title"><%=pageName%> page</h1>
                <button class="question-button" onclick="window.location.href='/news/<%= news._id %>/questions'">Posez une question</button>
                <% if (news.questions.length > 0) { %>
                        <% news.questions.forEach(question => { %>
                            <div class="question-card">
                                <div class="question-main">
                                    <span class="message-type">Question</span>
                                    <span class="message-user"><%=question.user.login%></span>
                                    <span class="message-date"><%=question.date.toLocaleDateString()%></span>
                                </div>
                                <div class="message-content">
                                    <p class="question-content"><%=question.contenu%></p>
                                    <button class="reponse-button" onclick="window.location.href='/news/<%= news._id %>/questions/<%= question._id %>'">Répondre</button>
                                </div>
                            </div>
                            <% question.reponses.forEach(reponse => { %>
                                <div class="reponse-card">
                                    <div class="reponse-main">
                                        <span class="message-type">Réponse</span>
                                        <span class="message-user"><%=reponse.user.login%></span>
                                        <span class="message-date"><%=reponse.date.toLocaleDateString()%></span>
                                    </div>
                                    <div class="message-content">
                                        <p class="reponse-content"><%=reponse.contenu%></p>
                                    </div>
                                </div>
                            <% }) %>
                        <% }) %>
                <% } else { %>
                    <p>Aucune question publiée</p>
                <% } %>
            </div>
        </div>
    </body>
</html>